{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sifrious/wardrobe",
    "description": "Runtime invocation boundary for approved agent adapters.",
    "license": "proprietary",
    "type": "library",
    "require": {"php": "^8.3"},
    "autoload": {"psr-4": {"Sifrious\\Wardrobe\\": "src/"}},
    "autoload-dev": {"psr-4": {"Sifrious\\Wardrobe\\Tests\\": "tests/"}},
    "scripts": {"test": "phpunit --colors=always tests"},
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
